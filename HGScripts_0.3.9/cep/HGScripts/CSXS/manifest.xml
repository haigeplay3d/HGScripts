<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="5.0" ExtensionBundleId="com.haige.hgscripts" ExtensionBundleName="HGScripts" ExtensionBundleVersion="0.3.9" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.haige.hgscripts.panel" Version="0.3.9"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[25.0,99.9]"/>
      <Host Name="PHXS" Version="[16.0,99.9]"/>
      <Host Name="PHSP" Version="[16.0,99.9]"/>
      <Host Name="IDSN" Version="[11.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="5.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.haige.hgscripts.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./scripts/main.jsx</ScriptPath>
          <Icons>
            <Icon Type="Normal">./assets/brand/hgscripts-app.png</Icon>
            <Icon Type="RollOver">./assets/brand/hgscripts-app.png</Icon>
            <Icon Type="DarkNormal">./assets/brand/hgscripts-app.png</Icon>
            <Icon Type="DarkRollOver">./assets/brand/hgscripts-app.png</Icon>
          </Icons>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--high-dpi-support=1</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Menu>海哥的Adobe脚本管理器 v0.3.9</Menu>
          <Type>Panel</Type>
          <Geometry>
            <!-- Size / MinSize 的单位是逻辑像素，宿主按系统缩放（本机 150%）乘一次。
                 252×278 × 1.513 ≈ 381×420，这是实测能完整显示标题、顶栏两行（搜索行 +
                 最近使用/收藏/默认/新建/添加目录）、「全部」标签、6 个脚本行（含第 6 行完整
                 行高不被裁）和底部状态栏的最小内容区尺寸。MinSize 是宿主执行的硬闸门：
                 拖到这里就停住，不会再小。
                 改这两个值时同步改 app.js 的 MIN_PANEL_WIDTH / MIN_PANEL_HEIGHT（内容区像素）。 -->
            <Size>
              <Width>254</Width>
              <Height>279</Height>
            </Size>
            <MinSize>
              <Width>252</Width>
              <Height>278</Height>
            </MinSize>
            <MaxSize>
              <Width>1400</Width>
              <Height>1800</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>

