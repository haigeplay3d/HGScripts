<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="5.0" ExtensionBundleId="com.haige.hgscripts" ExtensionBundleName="HGScripts" ExtensionBundleVersion="0.3.13" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.haige.hgscripts.panel" Version="0.3.13"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[25.0,99.9]"/>
      <Host Name="PHXS" Version="[16.0,99.9]"/>
      <Host Name="PHSP" Version="[16.0,99.9]"/>
      <Host Name="IDSN" Version="[11.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="5.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.haige.hgscripts.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./scripts/main.jsx</ScriptPath>
          <Icons>
            <Icon Type="Normal">./assets/brand/hgscripts-app.png</Icon>
            <Icon Type="RollOver">./assets/brand/hgscripts-app.png</Icon>
            <Icon Type="DarkNormal">./assets/brand/hgscripts-app.png</Icon>
            <Icon Type="DarkRollOver">./assets/brand/hgscripts-app.png</Icon>
          </Icons>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--high-dpi-support=1</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Menu>海哥的Adobe脚本管理器 v0.3.13</Menu>
          <Type>Panel</Type>
          <Geometry>
            <!-- Size / MinSize 的单位是 DIP（逻辑像素）：宿主拿它乘系统缩放（本机 150%）
                 再换算成屏幕像素，所以 252×278 DIP 在 150% 下是 378×417 的窗口。
                 MinSize 是宿主执行的硬闸门，拖到这里就停住，不会再小——代码侧不设任何
                 尺寸下限，唯一的闸门就是这里。
                 改这两个值时只改这里；app.js 的 FIRST_RUN_PANEL_* / NARROW_PANEL_* 是
                 「没有记忆时用哪一档」的默认值，单位同样是 DIP，目前与 MinSize 对齐。 -->
            <Size>
              <Width>254</Width>
              <Height>279</Height>
            </Size>
            <MinSize>
              <Width>252</Width>
              <Height>278</Height>
            </MinSize>
            <MaxSize>
              <Width>1400</Width>
              <Height>1800</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>

