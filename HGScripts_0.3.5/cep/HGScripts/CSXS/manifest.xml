<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="5.0" ExtensionBundleId="com.haige.hgscripts" ExtensionBundleName="HGScripts" ExtensionBundleVersion="0.3.5" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <ExtensionList>
    <Extension Id="com.haige.hgscripts.panel" Version="0.3.5"/>
  </ExtensionList>
  <ExecutionEnvironment>
    <HostList>
      <Host Name="ILST" Version="[25.0,99.9]"/>
      <Host Name="PHXS" Version="[16.0,99.9]"/>
      <Host Name="PHSP" Version="[16.0,99.9]"/>
      <Host Name="IDSN" Version="[11.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="5.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>
  <DispatchInfoList>
    <Extension Id="com.haige.hgscripts.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./index.html</MainPath>
          <ScriptPath>./scripts/main.jsx</ScriptPath>
          <Icons>
            <Icon Type="Normal">./assets/brand/hgscripts-app.png</Icon>
            <Icon Type="RollOver">./assets/brand/hgscripts-app.png</Icon>
            <Icon Type="DarkNormal">./assets/brand/hgscripts-app.png</Icon>
            <Icon Type="DarkRollOver">./assets/brand/hgscripts-app.png</Icon>
          </Icons>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--high-dpi-support=1</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
            </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Menu>海哥的Adobe脚本管理器 v0.3.5</Menu>
          <Type>Panel</Type>
          <Geometry>
            <Size>
              <Width>300</Width>
              <Height>320</Height>
            </Size>
            <MinSize>
              <Width>300</Width>
              <Height>300</Height>
            </MinSize>
            <MaxSize>
              <Width>1400</Width>
              <Height>1800</Height>
            </MaxSize>
          </Geometry>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>

